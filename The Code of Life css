body {
  font-family: Arial, sans-serif;
  background-color: #e8f5e9;
  text-align: center;
  margin-top: 50px;
}

h1 {
  color: #2e7d32;
}

button {
  background-color: #4caf50;
  color: white;
  border: none;
  padding: 10px 15px;
  margin: 8px;
  font-size: 16px;
  cursor: pointer;
  border-radius: 5px;
}

button:hover {
  background-color: #388e3c;
}

#result {
  font-size: 18px;
  margin-top: 15px;
  font-weight: bold;
}
