<!DOCTYPE html>
<html>
<head>
  <title>The Code of Life</title>
</head>

<body style="font-family: Arial; text-align:center;">

  <h1>The Code of Life 🧬</h1>
  <p id="question">What is the basic unit of life?</p>

  <button onclick="checkAnswer('A')">A. Cell</button>
  <button onclick="checkAnswer('B')">B. Atom</button>
  <button onclick="checkAnswer('C')">C. Tissue</button>

  <p id="result"></p>

  <script>
    function checkAnswer(answer) {
      if(answer === 'A') {
        document.getElementById("result").innerHTML = 
        "✅ Correct! Cell is the basic unit of life.";
      } else {
        document.getElementById("result").innerHTML = 
        "❌ Wrong! Try again.";
      }
    }
  </script>

</body>
</html>
